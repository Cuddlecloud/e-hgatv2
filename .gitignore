# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual envs / uv
.venv/
venv/
.python-version

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Editor / OS
.idea/
.vscode/
.snowflake/
.DS_Store

# Vendored libs / scratch (regenerable, heavy)
.pylibs/
tmp/

# Secrets / local environment
.env
*.env
secrets/

# Reference papers / third-party materials
*.pdf
refs/
typeset_equations/

# Experiment artifacts (heavy / regenerable). 
experiments/**/runs/
experiments/**/*.pt
experiments/**/*.png
!tests/data/golden/**

# LaTeX build artifacts
paper/*.log
paper/*.aux
paper/*.out
paper/*.synctex.gz

# Local vector store
data/chromadb/

# The *.pdf rule above is for the reference papers; the thesis's own figures and the compiled
# document are source and deliverable respectively, so they are re-included explicitly.
!thesis/figs/*.pdf
!thesis/main.pdf

# Third-party material and scratch, withheld from a PUBLIC remote:
#   large/      the advisor's own mp-BRKGA solver sources, supplied for this work
#   output/     a .tex/.log reconstruction of the advisor's published paper
#   outputs/    duplicate of data/Container_Transport_Parsed_Tables under a session UUID
# The first two are not ours to publish. Remove these lines to include them.
large/
output/
outputs/
thesis/*.log
thesis/*.blg
thesis/*.aux
thesis/*.out
thesis/*.toc
